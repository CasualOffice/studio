{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Studio",
  "version": "0.3.0-preview.3",
  "identifier": "com.melp.modelstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Model Studio",
        "width": 1240,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "zoomHotkeysEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' vault: http://vault.localhost data: blob:; media-src 'self' vault: http://vault.localhost blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "signingIdentity": "-"
    },
    "resources": {
      "../engine/worker.py": "engine/worker.py",
      "../engine/vaultcrypto.py": "engine/vaultcrypto.py",
      "../engine/story.py": "engine/story.py",
      "../engine/prompt_assist.py": "engine/prompt_assist.py",
      "../engine/audiobook.py": "engine/audiobook.py",
      "../engine/director.py": "engine/director.py",
      "../engine/narration.py": "engine/narration.py",
      "../engine/hinglish.py": "engine/hinglish.py",
      "../engine/hinglish.tsv": "engine/hinglish.tsv",
      "../engine/kokoro-requirements.lock": "engine/kokoro-requirements.lock"
    }
  }
}
